# Database
# In Railway: auto-populated by the Postgres plugin.
# Note: FastAPI uses asyncpg, so url begins with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bonbons

# Admin Single-Password Authentication
# Set either ADMIN_PASSWORD (plain text) or ADMIN_PASSWORD_HASH (bcrypt hash)
ADMIN_PASSWORD=change-this-to-your-secure-admin-password
# ADMIN_PASSWORD_HASH=$2b$12$...

# Storage / Persistent Volume Mount
# In Railway: mount volume to /data
STORAGE_DIR=./data

# Session settings
SESSION_LIFETIME_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS settings (comma-separated domains)
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# API Access Mode
# If false, ALL endpoints require an authenticated session.
# If true, GET /api/bonbons is publicly readable for the consumer storefront.
PUBLIC_READ_ACCESS=false
